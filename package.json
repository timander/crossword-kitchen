{
  "name": "crossword-kitchen",
  "version": "1.0.0",
  "private": true,
  "description": "Build printable, playable crossword puzzles from your own words and clues. Ships as one self-contained HTML file.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "mutation": "stryker run",
    "knip": "knip",
    "audit": "pnpm audit --prod --audit-level moderate",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm coverage && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
